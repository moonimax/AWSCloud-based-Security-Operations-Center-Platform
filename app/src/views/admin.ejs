<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>관리자</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>관리자 페이지</h1>
  <h2>사용자 (<%= users.length %>)</h2>
  <ul>
    <% users.forEach(function (u) { %><li><%= u.username %> (<%= u.role %>)</li><% }); %>
  </ul>
  <h2>게시글 (<%= posts.length %>)</h2>
  <ul>
    <% posts.forEach(function (p) { %><li><%= p.title %> - <%= p.authorName %></li><% }); %>
  </ul>
  <p><a href="/board">게시판으로</a></p>
</body>
</html>
