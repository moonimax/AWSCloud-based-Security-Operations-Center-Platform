    {
      "type": "timeseries",
      "title": "4xx·5xx 에러율 (%)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "refId": "A",
          "id": "",
          "queryMode": "Logs",
          "queryLanguage": "CWLI",
          "region": "$region",
          "logGroups": [
            {
              "arn": "$log_group",
              "name": "$log_group"
            }
          ],
          "logGroupNames": [
            "$log_group"
          ],
          "expression": "fields (status >= 400 and status < 500) as is4xx, (status >= 500) as is5xx\n| stats sum(is4xx) * 100 / count(*) as rate_4xx, sum(is5xx) * 100 / count(*) as rate_5xx by bin(1m)",
          "statsGroups": []
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 22,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "gradientMode": "opacity",
            "axisBorderShow": false,
            "axisGridShow": true,
            "barAlignment": 0,
            "pointSize": 4,
            "insertNulls": 120000
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rate_4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f5a524"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rate_5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f2495c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bin(1m)"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "시간"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "상태 코드"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rate_4xx"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "4xx 비율"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rate_5xx"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "5xx 비율"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 201
    },
