#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2 python3 unzip curl openssl nvme-cli
systemctl enable --now docker
# Ubuntu 24.04(noble)은 apt에 awscli 패키지가 없어서 공식 설치 스크립트를 사용한다.
curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q -o /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
# 루트 디스크를 건드리지 않고 지정한 EBS 볼륨의 NVMe 일련번호만 찾는다.
DEVICE=""
for attempt in $(seq 1 180); do
  DEVICE=$(lsblk -dn -o PATH,SERIAL | awk '$2 == "${volume_serial}" {print $1; exit}')
  if [ -n "$DEVICE" ]; then break; fi
  sleep 2
done
if [ -z "$DEVICE" ]; then echo '데이터 볼륨 연결을 확인하세요.' >&2; exit 1; fi
FSTYPE=$(blkid -s TYPE -o value "$DEVICE" || true)
if [ -z "$FSTYPE" ]; then
  # 기존 서명이나 파티션이 있으면 자동 포맷하지 않는다.
  if [ -n "$(wipefs -n --noheadings -o TYPE "$DEVICE")" ] || [ "$(lsblk -nr "$DEVICE" | wc -l)" -ne 1 ]; then
    echo '기존 디스크 내용을 확인해야 합니다. 자동 포맷을 중단합니다.' >&2; exit 1
  fi
  mkfs.ext4 "$DEVICE"
elif [ "$FSTYPE" != ext4 ]; then
  echo 'ext4 데이터 볼륨만 지원합니다.' >&2; exit 1
fi
mkdir -p /srv/monitoring-data
UUID=$(blkid -s UUID -o value "$DEVICE")
echo "UUID=$UUID /srv/monitoring-data ext4 defaults,nofail 0 2" >> /etc/fstab
mount /srv/monitoring-data
mkdir -p /opt/monitoring
aws s3 cp 's3://${bucket}/${key}' /tmp/monitoring.zip
unzip -o /tmp/monitoring.zip -d /opt/monitoring
printf '%s' '${datasource_b64}' | base64 -d > /opt/monitoring/runtime/grafana/provisioning/datasources/loki.yaml
printf '%s' '${runtime_env_b64}' | base64 -d > /opt/monitoring/runtime/.env
mkdir -p /opt/monitoring/runtime/grafana/provisioning/alerting
printf '%s' '${contactpoint_b64}' | base64 -d > /opt/monitoring/runtime/grafana/provisioning/alerting/contactpoints.yaml
printf '%s' '${policy_b64}' | base64 -d > /opt/monitoring/runtime/grafana/provisioning/alerting/policies.yaml
mkdir -p /srv/monitoring-data/secrets
chmod 700 /srv/monitoring-data/secrets
ln -s /srv/monitoring-data/secrets /opt/monitoring/runtime/secrets
python3 /opt/monitoring/scripts/init_local.py
cat > /etc/systemd/system/monitoring.service <<'EOF'
[Unit]
Description=Integrated monitoring Compose stack
Requires=docker.service
After=docker.service network-online.target
RequiresMountsFor=/srv/monitoring-data
[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/monitoring/runtime
ExecStartPre=/usr/bin/mountpoint -q /srv/monitoring-data
ExecStart=/usr/bin/docker compose --profile aws up -d --build
ExecStop=/usr/bin/docker compose --profile aws down
TimeoutStartSec=900
[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now monitoring
touch /opt/monitoring/bootstrap-complete
